# Root environment template for Docker Compose (local integration + VPS).
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
#   cp .env.example .env
#
# Backend-only secrets are read by the backend service at runtime.
# Frontend public config is safe for browsers — keep them separate.

# ── Container images (VPS deploy — pull dari GHCR, jangan build di VPS) ─
# Tag :latest = hasil push branch main. Untuk deploy deterministik pakai
# tag SHA: ghcr.io/muhammad2341/e-math-learning-backend:<commit-sha>
BACKEND_IMAGE=ghcr.io/muhammad2341/e-math-learning-backend:latest
FRONTEND_IMAGE=ghcr.io/muhammad2341/e-math-learning-frontend:latest

# ── Frontend (public, browser-visible) ─────────────────────────────────
# What the BROWSER uses to reach the API:
NUXT_PUBLIC_API_BASE=http://localhost:3001/api
# VPS value: NUXT_PUBLIC_API_BASE=https://api.faridpens.my.id/api

# ── Backend (secrets / server-side) ────────────────────────────────────
# Default points at MongoDB installed on the HOST (VPS or dev machine).
MONGODB_URI=mongodb://host.docker.internal:27017/e-learning-math
# VPS value: MONGODB_URI=mongodb://127.0.0.1:27017/e-learning-math  (via host.docker.internal → host)

# Required in production (docker-compose.prod.yml refuses to start without it).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origins for CORS (comma-separated).
CORS_ORIGIN=http://localhost:3000
# VPS value: CORS_ORIGIN=https://faridpens.my.id
